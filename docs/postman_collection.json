{
  "info": {
    "name": "PFA Reservation API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0"
  },
  "variable": [
    { "key": "authUrl", "value": "http://localhost:8081" },
    { "key": "bookingUrl", "value": "http://localhost:8082" },
    { "key": "notificationUrl", "value": "http://localhost:8083" },
    { "key": "paymentUrl", "value": "http://localhost:8084" },
    { "key": "token", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "bookingId", "value": "1" },
    { "key": "username", "value": "prof" },
    { "key": "email", "value": "youssef.tazi.fst@uhp.ac.ma" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register - Etudiant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"etudiant.demo\",\n  \"email\": \"imane.rachidi.fst@uhp.ac.ma\",\n  \"password\": \"demo1234\",\n  \"role\": \"ETUDIANT\",\n  \"firstName\": \"Imane\",\n  \"lastName\": \"Rachidi\",\n  \"filiere\": \"GI\"\n}"
            },
            "url": "{{authUrl}}/auth/register"
          }
        },
        {
          "name": "Register - Professeur (code requis)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"prof.demo\",\n  \"email\": \"youssef.tazi.fst@uhp.ac.ma\",\n  \"password\": \"demo1234\",\n  \"role\": \"PROF\",\n  \"adminCode\": \"pfa-prof-2026\",\n  \"firstName\": \"Youssef\",\n  \"lastName\": \"Tazi\",\n  \"filiere\": \"GI\"\n}"
            },
            "url": "{{authUrl}}/auth/register"
          }
        },
        {
          "name": "Register - Chef de filiere (code + filiere requis)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"chef.demo\",\n  \"email\": \"nadia.alaoui.fst@uhp.ac.ma\",\n  \"password\": \"demo1234\",\n  \"role\": \"CHEF_FILIERE\",\n  \"adminCode\": \"pfa-chef-2026\",\n  \"filiere\": \"GI\"\n}"
            },
            "url": "{{authUrl}}/auth/register"
          }
        },
        {
          "name": "Register - Doyen (code requis)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"doyen.demo\",\n  \"email\": \"karim.benali.fst@uhp.ac.ma\",\n  \"password\": \"demo1234\",\n  \"role\": \"DOYEN\",\n  \"adminCode\": \"pfa-doyen-2026\"\n}"
            },
            "url": "{{authUrl}}/auth/register"
          }
        },
        {
          "name": "Register - Club (code + club requis)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"club.robo\",\n  \"email\": \"club.robo.fst@uhp.ac.ma\",\n  \"password\": \"club1234\",\n  \"role\": \"CLUB\",\n  \"adminCode\": \"pfa-club-2026\",\n  \"club\": \"CLIC\"\n}"
            },
            "url": "{{authUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('token', body.token || '');",
                  "pm.collectionVariables.set('refreshToken', body.refreshToken || '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"prof123\"\n}"
            },
            "url": "{{authUrl}}/auth/login"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": "{{authUrl}}/auth/refresh"
          }
        },
        {
          "name": "Forgot Password (demo)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\"\n}" },
            "url": "{{authUrl}}/auth/forgot"
          }
        },
        {
          "name": "Verify Account (demo)",
          "request": { "method": "GET", "url": "{{authUrl}}/auth/verify?token={{verifyToken}}" }
        }
      ]
    },
    {
      "name": "Admin - Users",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{authUrl}}/auth/users"
          }
        },
        {
          "name": "Create user (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"nouveau.prof\",\n  \"password\": \"prof123\",\n  \"role\": \"PROF\",\n  \"firstName\": \"Salma\",\n  \"lastName\": \"El Idrissi\",\n  \"filiere\": \"GI\"\n}" },
            "url": "{{authUrl}}/auth/users"
          }
        },
        {
          "name": "Update user role",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"PROF\"\n}" },
            "url": "{{authUrl}}/auth/users/2/role"
          }
        },
        {
          "name": "Update user filiere",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"filiere\": \"GI\"\n}" },
            "url": "{{authUrl}}/auth/users/2/filiere"
          }
        }
      ]
    },
    {
      "name": "Resources",
      "item": [
        {
          "name": "List resources",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{bookingUrl}}/resources"
          }
        },
        {
          "name": "Create resource (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Salle A01\",\n  \"category\": \"TD\",\n  \"type\": \"TD\",\n  \"capacity\": 40,\n  \"building\": \"Bloc A\",\n  \"floor\": \"RDC\",\n  \"equipment\": \"Projecteur, Tableau blanc\",\n  \"equipments\": [\"Projecteur\", \"Tableau blanc\"],\n  \"price\": 0\n}"
            },
            "url": "{{bookingUrl}}/resources"
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Check availability",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{bookingUrl}}/bookings/availability?resource=Amphi%201&date=2026-10-01&creneau=08:30-10:30"
          }
        },
        {
          "name": "Create booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resource\": \"Amphi 1\",\n  \"date\": \"2026-10-01\",\n  \"creneau\": \"08:30-10:30\",\n  \"username\": \"{{username}}\",\n  \"filiere\": \"GI\",\n  \"motif\": \"Cours de développement web\"\n}"
            },
            "url": "{{bookingUrl}}/bookings"
          }
        },
        {
          "name": "Calendar (jour / semaine / mois)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{bookingUrl}}/bookings/calendar?from=2026-10-01&to=2026-10-07&resource=Amphi%201&filiere=GI"
          }
        },
        {
          "name": "My bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{bookingUrl}}/bookings/mine?username={{username}}"
          }
        },
        {
          "name": "Pending approvals (chef / doyen)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{bookingUrl}}/bookings/approvals"
          }
        },
        {
          "name": "Approve (chef de filiere)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{bookingUrl}}/bookings/{{bookingId}}/approve?comment=Traitement%20valid%C3%A9"
          }
        },
        {
          "name": "Reject (chef / doyen)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{bookingUrl}}/bookings/{{bookingId}}/reject?comment=Salle%20indisponible"
          }
        },
        {
          "name": "Confirm - cachet doyen (paiement auto)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{bookingUrl}}/bookings/{{bookingId}}/confirm?comment=Cachet%20final"
          }
        },
        {
          "name": "Attach document (PDF)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": [] }]
            },
            "url": "{{bookingUrl}}/bookings/{{bookingId}}/document"
          }
        },
        {
          "name": "Download document",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{bookingUrl}}/bookings/{{bookingId}}/document"
          }
        },
        {
          "name": "Download signed document (evenement club)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{bookingUrl}}/bookings/{{bookingId}}/signed-document"
          }
        },
        {
          "name": "Cancel booking",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{bookingUrl}}/bookings/{{bookingId}}?username={{username}}&role=PROF"
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "My notifications (par role/filiere)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{notificationUrl}}/notifications/my"
          }
        },
        {
          "name": "Unread count",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{notificationUrl}}/notifications/unread-count"
          }
        },
        {
          "name": "Mark one as read",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{notificationUrl}}/notifications/1/read"
          }
        },
        {
          "name": "Mark all as read",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{notificationUrl}}/notifications/read-all"
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create payment (mock)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservationId\": \"{{bookingId}}\",\n  \"amount\": 150,\n  \"username\": \"{{username}}\"\n}"
            },
            "url": "{{paymentUrl}}/payments"
          }
        }
      ]
    }
  ]
}
